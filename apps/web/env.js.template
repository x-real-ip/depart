// Wordt bij het opstarten van de container gegenereerd uit de omgeving.
// API_TOKEN moet gelijk zijn aan dat van de api; leeg laten voor een open api.
// De token staat hiermee wel in de browser — de echte afscherming zit in het
// netwerk (de app hangt achter de private gateway). Dit is een tweede slot.
window.__ENV__ = {
  API_TOKEN: "${API_TOKEN}",
  APP_TITLE: "${APP_TITLE}",
};
