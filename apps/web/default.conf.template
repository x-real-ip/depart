server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Uploads mogen 20 MB zijn; nginx moet dat doorlaten voordat de api er iets
    # over kan zeggen.
    client_max_body_size 21m;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # env.js wordt bij het opstarten gegenereerd en mag niet blijven hangen.
    location = /env.js {
        add_header Cache-Control "no-store";
    }

    # De api zit achter deze proxy; de host komt uit BACKEND_URL.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Een grote upload of een trage schijf mag niet in een timeout lopen.
        proxy_read_timeout 120s;
        proxy_request_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
