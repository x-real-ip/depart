# Kopieer dit bestand naar .env en pas de waardes aan.
# .env staat in .gitignore en hoort daar te blijven.

POSTGRES_USER=depart
POSTGRES_PASSWORD=changeme
POSTGRES_DB=depart

# Leeg laten voor een open api, of een geheime token zetten. In productie komt
# deze uit het SealedSecret; de echte afscherming is het netwerk.
API_TOKEN=

# Titel bovenin de app.
APP_TITLE=Depart

# debug, info, warn of error.
LOG_LEVEL=info
