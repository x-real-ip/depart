# Kopieer dit bestand naar .env en pas de waardes aan.
# .env staat in .gitignore en hoort daar te blijven.

POSTGRES_USER=depart
POSTGRES_PASSWORD=changeme
POSTGRES_DB=depart

# Leeg laten voor een open api, of een geheime token zetten. In productie komt
# deze uit het SealedSecret; de echte afscherming is het netwerk.
API_TOKEN=

# Titel bovenin de app.
APP_TITLE=Depart

# debug, info, warn of error.
LOG_LEVEL=info

# Weer en route komen van publieke diensten die geen sleutel nodig hebben.
# Zet op false om de app zonder internet te draaien; de schermen melden dan
# netjes dat er geen weer- of routegegevens zijn.
EXTERN_ENABLED=true
# Eigen instantie gebruiken? Vul dan een ander adres in.
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_URL=https://api.open-meteo.com/v1/forecast
ROUTING_URL=https://router.project-osrm.org
# Adres-autocomplete (thuisadres, camping, overnachtingen): Photon, gebouwd op
# OpenStreetMap. Vindt ook straten en plekken, niet alleen steden.
ADDRESS_AUTOCOMPLETE_URL=https://photon.komoot.io/api/
# Hoe lang een antwoord in het geheugen blijft staan.
EXTERN_CACHE_MINUTES=30

# Actuele verkeersinformatie en de tolkosten-schatting zijn de enige externe
# diensten die wél een sleutel nodig hebben — dat is nu eenmaal niet zonder te
# krijgen. Leeg laten: de app werkt gewoon door, alleen zonder die twee
# secties op het tabblad Onderweg. Gratis sleutel: developer.tomtom.com.
TOMTOM_API_KEY=
TOMTOM_INCIDENTS_URL=https://api.tomtom.com/traffic/services/5/incidentDetails
TOMTOM_ROUTING_URL=https://api.tomtom.com/routing/1/calculateRoute
